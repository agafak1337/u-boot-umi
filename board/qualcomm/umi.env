bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Probe UFS before anything else may look for it.
preboot=scsi scan

# Try the EFI application packed as the Android ramdisk (xnuloader.efi
# or any other PE/COFF). ABL stores its load address and size in
# /chosen/linux,initrd-start and linux,initrd-end; our local patch
# exposes them as prevbl_initrd_start_addr / prevbl_initrd_size. If
# there is nothing there, drop to fastboot so the board is still
# reachable over USB with a black panel.
bootcmd=if test -n "${prevbl_initrd_size}"; then echo "Booting EFI payload at ${prevbl_initrd_start_addr} (${prevbl_initrd_size} bytes)"; bootefi ${prevbl_initrd_start_addr}:${prevbl_initrd_size} ${fdtcontroladdr}; fi; echo "U-Boot umi: entering fastboot"; run fastboot

# When entering the menu (button held or boot failure), keep re-opening it.
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Holding Volume Down during boot opens this menu.
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

bootmenu_0=Enter fastboot=run fastboot
bootmenu_1=Boot EFI payload=bootefi ${prevbl_initrd_start_addr}:${prevbl_initrd_size} ${fdtcontroladdr}; pause
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
bootmenu_10=Power off=poweroff

# Enable the USB ACM console without a menu.
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo "Enabled U-Boot console over USB ACM"