# Xiaomi Mi 10 (umi) - U-Boot config fragment.
#
# Usage (inside the U-Boot tree):
#   make O=out qcom_defconfig qcom-phone.config umi.config
#
# This fragment runs after qcom-phone.config.

# Build and embed only the umi DT, not every qcom board.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8250-xiaomi-umi"
# CONFIG_OF_UPSTREAM_BUILD_VENDOR is not set

# SMEM is how U-Boot learns the real DRAM layout when the DT has no
# /memory node. ARCH_SNAPDRAGON selects it in 2027.01, but keep it
# explicit so an older/newer tag cannot silently drop it.
CONFIG_QCOM_SMEM=y

# Run EFI applications (bootefi). Override qcom-phone.env with umi.env,
# which tries the EFI payload packed as the Android ramdisk and then
# falls back to U-Boot's own fastboot.
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/umi.env"

# The console record buffer is what `fastboot oem console` dumps when
# the panel stays black. Give it a bit more room than the default.
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000

# Reading files from UFS/ext4 is handy once the display works.
CONFIG_FS_EXT4=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y